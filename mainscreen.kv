#: import hex_color kivy.utils.get_color_from_hex
<MainScreen>:
    MDNavigationLayout:
        ScreenManager:
            MDScreen:
                md_bg_color: self.theme_cls.backgroundColor

                BoxLayout:
                    orientation: 'vertical'
                    

                    MDTopAppBar:
                        type: "small"
                        theme_bg_color: "Custom"
                        md_bg_color:hex_color("#ff00aae0")
                        MDTopAppBarLeadingButtonContainer:
                            MDActionTopAppBarButton:
                                icon: "menu"
                               
                            MDActionTopAppBarButton:
                                icon: "theme-light-dark"
                                on_release: app.switch_theme_style()
                        
                        MDTopAppBarTitle:
                            text: "PiggyBankExpanseTracker"
                            halign: "center"

                        MDTopAppBarTrailingButtonContainer:
                            MDActionTopAppBarButton:
                                id: account_button
                                icon: "account-circle-outline"
                                on_release: app.open_account_menu(self)
                    BoxLayout:
                        orientation:'vertical'
                        spacing:10
                        padding:50
                        pos_hint: {'center_x': 0.5,'center_y': 0.5}
                        MDCard:
                            size_hint_x: None
                            size: 400,200
                            pos_hint: {'center_x': 0.5,'center_y': 0.5}
                            MDLabel:
                                id:balance_label
                                text:"Balance:"
                                halign:"left"
                        MDCard:
                            size_hint_x: None
                            size: 400,200
                            pos_hint: {'center_x': 0.5,'center_y': 0.5}
                            MDLabel:
                                id: total_label
                                size_hint_x: None
                                text:"Saveings:"
                                halign:"left"
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center" 
                        GridLayout:
                            cols:4
                            padding:10
                            adaptive_height: True
                            ImageGrid:
                                orientation: "vertical"
                                adaptive_height: True
                                padding: "12dp"
                                spacing: "8dp"
                                on_press: app.root.current = 'addfund'
                                Image:
                                    source: "assist/add.png"
                                    size_hint: None, None
                                    size: 64, 64
                                    pos_hint: {'center_x': 0.5}
                                    adaptive_height: True
                                MDLabel:
                                    text: "Add Fund"
                                    halign: "center"
                                    adaptive_height: True
                                    style: "label-large"
                                    theme_text_color: "Primary"
                            ImageGrid:
                                orientation: "vertical"
                                adaptive_height: True
                                padding: "12dp"
                                spacing: "8dp"
                                on_press: app.root.current = 'bill'
                                Image:
                                    source: "assist/billing.png"
                                    size_hint: None, None
                                    size: 64, 64
                                    pos_hint: {'center_x': 0.5}
                                    adaptive_height: True
                                MDLabel:
                                    text: "Add Bill"
                                    halign: "center"
                                    adaptive_height: True
                                    style: "label-large"
                                    theme_text_color: "Primary"
                            ImageGrid:
                                orientation: "vertical"
                                adaptive_height: True
                                padding: "12dp"
                                spacing: "8dp"
                                on_press: app.root.current = 'target'
                                Image:
                                    source: "assist/targeting.png"
                                    size_hint: None, None
                                    size: 64, 64
                                    pos_hint: {'center_x': 0.5}
                                    adaptive_height: True
                                MDLabel:
                                    text: "Target"
                                    halign: "center"
                                    adaptive_height: True
                                    style: "label-large"
                                    theme_text_color: "Primary"
                            ImageGrid:
                                orientation: "vertical"
                                adaptive_height: True
                                padding: "12dp"
                                spacing: "8dp"
                                on_press: app.root.current = 'addfund'
                                Image:
                                    source: "assist/time.png"
                                    size_hint: None, None
                                    size: 64, 64
                                    pos_hint: {'center_x': 0.5}
                                    adaptive_height: True
                                MDLabel:
                                    text: "Saveing Overview"
                                    halign: "center"
                                    adaptive_height: True
                                    style: "label-large"
                                    theme_text_color: "Primary"   
                        
                        MDScrollView:
                            size_hint_y: 0.4 
                            MDBoxLayout:
                                id: bills_history_list  
                                orientation: 'vertical'
                                adaptive_height: True
                                spacing: "10dp"
                                padding: "20dp"
                        
                        MDButton:

                            on_release: app.root.current = "target"
                            MDButtonText:
                                text: "View All Savings Goals"                     